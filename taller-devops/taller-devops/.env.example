# Copiar a .env (no se sube a Git). Docker Compose lo lee solo.
GRAFANA_PASSWORD=cambiame
DASHBOARD_TAG=taller-devops      # rama/etiqueta de la imagen en ghcr.io (latest cuando se una a main)
DASHBOARD_MEM=256m               # limite de memoria (demo de cgroups: bajalo a 32m y mira que pasa)
DASHBOARD_CPUS=1.0               # limite de CPU    (demo: 0.1)
# Solo en el servidor Linux:
# COMPOSE_PROFILES=server
